<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.mpvex" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar" />

    <style name="Theme.mpvex.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_animated</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.mpvex</item>
    </style>

    <style name="Theme.mpvex.Player" parent="Theme.mpvex">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.mpvex.Transparent" parent="Theme.mpvex">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
